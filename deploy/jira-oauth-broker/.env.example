# Public DNS name that resolves to this deployment. Do not include a scheme.
BROKER_DOMAIN=jira-oauth.example.com

# Contact used by the ACME certificate authority.
ACME_EMAIL=operator@example.com

# Public identifier from the Atlassian developer console.
ATLASSIAN_CLIENT_ID=replace-with-client-id

# Absolute host path to a file containing only the Atlassian client secret.
# Keep the real file outside the repository and out of backups/logs.
ATLASSIAN_CLIENT_SECRET_FILE=/secure/host/path/atlassian-client-secret
