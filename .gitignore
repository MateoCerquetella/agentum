# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Node
.pnpm-store

# Desktop UI (React/Vite) — build artifacts, not source.
crates/agentum-desktop/ui/node_modules
crates/agentum-desktop/ui/dist

