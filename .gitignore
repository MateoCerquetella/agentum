# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Node
.pnpm-store

# Python test/tool caches
__pycache__/
*.py[cod]

# Desktop UI (React/Vite) — build artifacts, not source.
crates/agentum-desktop/ui/node_modules
crates/agentum-desktop/ui/dist

# Editors
.DS_Store
.idea
.vscode/settings.json
*.swp
*.swo

# Local env
.env
.env.local
*.log

# Claude Code workspace metadata — ignore everything except the tracked,
# team-wide settings file (permission allowlist). `.claude/` would exclude
# the directory itself, making the negation unreachable, hence `/*`.
.claude/*
!.claude/settings.json
.syncthing.*
.playwright-mcp/

# Runtime upload sink — written by the dashboard's drag-drop / paste flow.
# Local data, not source — should never enter the repo.
.agentum-uploads/
