<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied to the signed macOS application by Tauri. Agentum captures voice
  dictation with CoreAudio, so the hardened runtime must explicitly permit
  microphone input. Keep this file minimal: no sandbox or runtime bypasses.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
