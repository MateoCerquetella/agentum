{
  "productName": "Agentum",
  "version": "0.38.1",
  "identifier": "dev.agentum.app",
  "build": {
    "frontendDist": "ui/dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run --bun build",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Agentum",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MateoCerquetella/agentum/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5MTQ2QzM5QzkwQzUwQTEKUldTaFVBekpPV3dVZVhVNVc1NFBpVnBFeUpYcEE5NUEydkUxMFFxblhEV3VBUXM0QzlDUXo1K1oK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "frameworks": [
        "../../target/release/libsherpa-onnx-c-api.dylib",
        "../../target/release/libsherpa-onnx-cxx-api.dylib",
        "../../target/release/libonnxruntime.1.17.1.dylib"
      ]
    }
  }
}