{
  "productName": "agentum",
  "version": "0.13.0",
  "identifier": "dev.agentum.app",
  "build": {
    "frontendDist": "ui/dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run --bun build"
  },
  "app": {
    "windows": [
      {
        "title": "agentum",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
