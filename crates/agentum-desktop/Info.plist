<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the macOS app's Info.plist by Tauri (bundle.macOS.infoPlist).

  The desktop shell loads bundled frontend assets. Those assets call the
  in-process Agentum API over a random http://127.0.0.1:<port> endpoint.
  NSAllowsLocalNetworking permits that loopback API without granting an
  arbitrary-load exception to unrelated network destinations.
-->
<plist version="1.0">
<dict>
  <!-- Voice dictation captures the microphone natively (cpal/CoreAudio), since
       macOS WKWebView does not expose getUserMedia. macOS requires this usage
       string to grant mic access (TCC prompt on first capture). -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Agentum uses the microphone for on-device voice dictation.</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
