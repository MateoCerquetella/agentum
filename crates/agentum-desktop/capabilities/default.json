{
  "identifier": "default",
  "description": "Core capability for the main window. Grants permissions for tray icon, native menus, window state persistence, and basic IPC.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:tray:default",
    "core:menu:default",
    "window-state:default",
    "notification:default"
  ]
}
